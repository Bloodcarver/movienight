<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Filmkväll</title>
  <style>
    body { margin: 0; min-height: 100dvh; display: flex; align-items: center; justify-content: center;
           background: #14111c; color: #f3eff9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 16px; box-sizing: border-box; }
    .box { max-width: 420px; width: 100%; text-align: center; }
    h1 { margin: 0 0 6px; }
    p { color: #a69cba; margin: 6px 0; }
    #qr { background: #fff; border-radius: 16px; padding: 14px; width: min(280px, 80vw); aspect-ratio: 1; margin: 20px auto; box-sizing: border-box; }
    #qr svg { width: 100%; height: 100%; display: block; }
    a.btn { display: inline-block; margin-top: 8px; background: #f5b942; color: #1b1404; font-weight: 700; padding: 12px 20px; border-radius: 12px; text-decoration: none; }
    code { word-break: break-all; color: #f3eff9; font-size: 13px; }
    .ip { margin-top: 28px; font-size: 13px; }
  </style>
</head>
<body>
  <div class="box">
    <h1>🎬 Filmkväll</h1>
    <p>Skanna QR-koden med mobilen för att öppna appen.</p>
    <div id="qr"></div>
    <a class="btn" id="open" href="/__SECRET__/">Öppna här</a>
    <p><code id="link"></code></p>
    <p class="ip">Den här sidan syns bara hemifrån. Du uppfattas som <b>__CLIENT_IP__</b>.</p>
  </div>
  <script src="/__SECRET__/qrcode.min.js"></script>
  <script>
    var url = location.origin + "/__SECRET__/";
    document.getElementById("link").textContent = url;
    var qr = qrcode(0, "M"); qr.addData(url); qr.make();
    document.getElementById("qr").innerHTML = qr.createSvgTag({ cellSize: 4, margin: 0, scalable: true });
  </script>
</body>
</html>
