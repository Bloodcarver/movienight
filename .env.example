# Kopiera till .env och fyll i.

# Porten appen svarar på (det här pekar du NPM mot)
PORT=8095

# Porten för PocketBase adminpanel. Bara för hemmanätet, öppna den inte i routern.
ADMIN_PORT=8091
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=byt-till-ett-langt-losenord

# Jellyfin, så som containern når den (inte localhost)
JELLYFIN_URL=http://192.168.0.14:8096
# Kontrollpanelen -> API-nycklar -> +
JELLYFIN_API_KEY=
# Behövs bara om din Jellyfin-version inte listar filmer utan användare:
# Kontrollpanelen -> Användare -> klicka på en användare, id:t står i adressfältet (userId=...)
JELLYFIN_USER_ID=

# TMDB: themoviedb.org -> Inställningar -> API. Både API-nyckel (v3) och läs-token (v4) fungerar.
# Lämnas den tom hoppas favoritsteget över och förslagen bygger bara på genrer.
TMDB_API_KEY=

# Vilka nät som får se QR-sidan på /  (kommaseparerat)
QR_ALLOWED_NETWORK=192.168.0.0/24

# Proxyer vars X-Forwarded-For vi litar på: NPM och Dockers interna nät
TRUSTED_PROXY=192.168.0.14,172.16.0.0/12

# Hur länge ett rum lever, och hur många filmer man swipar på
ROOM_TTL_HOURS=24
CANDIDATE_COUNT=25

# Valfritt: sätt en egen hemlig sökväg (minst 12 tecken A-Z a-z 0-9).
# Tom = slumpas fram första gången och sparas i data/secret/secret.txt
APP_SECRET=
